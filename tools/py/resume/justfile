update-pdf folder:
    @just md2pdf "{{ folder }}/gen/resume.md" "{{ folder }}/gen/resume.pdf"

md2pdf input output options="--check --fix":
    uv run python tools/process_resume.py {{ options }} "{{ input }}"
    uv run python tools/md2pdf.py "{{ input }}" --output "{{ output }}"
    uv run python tools/check_pdf.py "{{ output }}"

check-pdf pdf:
    uv run python tools/check_pdf.py "{{ pdf }}"

# Compose Resume from folder
auto-compose-resume folder:
    uv run python tools/compose_resume.py {{ folder }} --model "gemma-4-26b-a4b-it"

# Compose Resume from CSV file
auto-compose-csv path:
