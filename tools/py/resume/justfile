set shell := ["bash", "-cu"]
set dotenv-path := "../private/.env"
set dotenv-required := true

master_resume := "./tmp/master_resume.md"
resumebody := "./private/parts/body.md"

default:
    @just --list

cfg-create:
    uv run python tools/cfg.py --create

cfg-check path="":
    uv run python tools/cfg.py --check {{ if path == "" { "" } else { "--path " + path } }}

check:
    uv run python tools/process_resume.py --check {{ resumebody }}

fix:
    uv run python tools/process_resume.py --fix {{ master_resume }}

combine:
    uv run python tools/combine_resume_parts.py \
      --header ./private/parts/header.md \
      --body {{ resumebody }} \
      --footer ./private/parts/footer.md \
      --output {{ master_resume }}

run: check combine
    # fix
    uv run python tools/process_resume.py --fix {{ master_resume }}

    # create text to tailor resume for job description
    /home/kirill/prj/gh/job-hunt/tools/prep_for_cv_tail/target/debug/prep_for_tail \
      --cv {{ master_resume }} \
      --prompt ./prompts/tailor_for_description.md \
      --jd ./tmp/jd.txt \
      --output ./tmp/prompt_to_tailor_for_description.md

    # evaluate match
    # cat ./prompt_match.md > "./tmp/prompt_to_match.md"
